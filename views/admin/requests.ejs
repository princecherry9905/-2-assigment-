<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="app-container">
  <%- include('../partials/alerts') %>

  <div class="dashboard-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
    <div>
      <h1 class="welcome-title">Pickup Requests Management</h1>
      <p class="sub-title">Review citizen requests, approve/reject, and assign collection agents & centres</p>
    </div>

    <!-- FILTER BUTTONS -->
    <div style="display: flex; gap: 0.4rem; flex-wrap: wrap;">
      <a href="/admin/requests" class="btn <%= selectedStatus === 'all' ? 'btn-primary' : 'btn-outline' %> btn-sm">All</a>
      <a href="/admin/requests?status=Requested" class="btn <%= selectedStatus === 'Requested' ? 'btn-primary' : 'btn-outline' %> btn-sm">Requested</a>
      <a href="/admin/requests?status=Approved" class="btn <%= selectedStatus === 'Approved' ? 'btn-primary' : 'btn-outline' %> btn-sm">Approved</a>
      <a href="/admin/requests?status=Scheduled" class="btn <%= selectedStatus === 'Scheduled' ? 'btn-primary' : 'btn-outline' %> btn-sm">Scheduled</a>
      <a href="/admin/requests?status=Collected" class="btn <%= selectedStatus === 'Collected' ? 'btn-primary' : 'btn-outline' %> btn-sm">Collected</a>
      <a href="/admin/requests?status=Recycled" class="btn <%= selectedStatus === 'Recycled' ? 'btn-primary' : 'btn-outline' %> btn-sm">Recycled</a>
    </div>
  </div>

  <div class="content-card">
    <% if (requests.length === 0) { %>
      <div style="text-align: center; padding: 3rem 1rem; color: var(--text-muted);">
        <i class="fa-solid fa-list-check" style="font-size: 3rem; color: #CBD5E1; margin-bottom: 1rem;"></i>
        <h3>No Requests Found</h3>
        <p>There are no pickup requests matching this filter.</p>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="custom-table">
          <thead>
            <tr>
              <th>ID</th>
              <th>Citizen & Address</th>
              <th>Item / Weight</th>
              <th>Date</th>
              <th>Status</th>
              <th>Assigned Agent & Centre</th>
              <th>Admin Action / Assignment</th>
            </tr>
          </thead>
          <tbody>
            <% requests.forEach(function(r) { %>
              <tr>
                <td style="font-weight: 700; color: var(--primary-dark);">#<%= r._id.toString().slice(-6).toUpperCase() %></td>
                <td>
                  <strong><%= r.citizen ? r.citizen.name : 'Unknown' %></strong> (<%= r.citizen ? r.citizen.phone : '' %>)<br>
                  <span style="font-size: 0.8rem; color: var(--text-muted);">📍 <%= r.address %></span>
                </td>
                <td>
                  <%= r.category ? r.category.icon : '📱' %> <strong><%= r.category ? r.category.name : 'N/A' %></strong><br>
                  <span style="font-size: 0.85rem;"><%= r.quantity %> items • ⚖ <%= r.approximateWeight %> KG</span>
                </td>
                <td><%= new Date(r.preferredDate).toLocaleDateString() %></td>
                <td>
                  <span class="status-badge badge-<%= r.status.toLowerCase() %>"><%= r.status %></span>
                </td>
                <td>
                  <% if (r.agent) { %>
                    <div><strong>Agent:</strong> <%= r.agent.name %></div>
                  <% } else { %>
                    <span style="color: var(--text-muted); font-style: italic;">No Agent</span>
                  <% } %>
                  <% if (r.collectionCentre) { %>
                    <div style="font-size: 0.8rem; color: var(--text-muted);"><strong>Centre:</strong> <%= r.collectionCentre.name %></div>
                  <% } %>
                </td>
                <td style="min-width: 220px;">
                  <% if (r.status === 'Requested') { %>
                    <div style="display: flex; gap: 0.4rem;">
                      <form action="/admin/request/<%= r._id %>/approve" method="POST">
                        <button type="submit" class="btn btn-accent btn-sm">Approve</button>
                      </form>
                      <button class="btn btn-outline btn-sm" onclick="toggleRejectForm('<%= r._id %>')">Reject</button>
                    </div>

                    <!-- Hidden Reject Form -->
                    <div id="reject-form-<%= r._id %>" style="display: none; margin-top: 0.5rem;">
                      <form action="/admin/request/<%= r._id %>/reject" method="POST">
                        <input type="text" name="rejectionReason" class="form-control" placeholder="Reason for rejection" required style="font-size: 0.8rem; padding: 0.35rem 0.5rem; margin-bottom: 0.3rem;">
                        <button type="submit" class="btn btn-sm" style="background: #EF4444; color: #FFF; width: 100%;">Confirm Reject</button>
                      </form>
                    </div>
                  <% } else if (r.status === 'Approved' || r.status === 'Scheduled') { %>
                    <form action="/admin/request/<%= r._id %>/assign" method="POST" style="display: flex; flex-direction: column; gap: 0.3rem;">
                      <select name="agentId" class="form-select" style="font-size: 0.8rem; padding: 0.3rem 0.5rem;" required>
                        <option value="">Select Agent...</option>
                        <% agents.forEach(function(ag) { %>
                          <option value="<%= ag._id %>" <%= r.agent && r.agent._id.toString() === ag._id.toString() ? 'selected' : '' %>>
                            <%= ag.name %>
                          </option>
                        <% }) %>
                      </select>

                      <select name="centreId" class="form-select" style="font-size: 0.8rem; padding: 0.3rem 0.5rem;" required>
                        <option value="">Select Centre...</option>
                        <% centres.forEach(function(c) { %>
                          <option value="<%= c._id %>" <%= r.collectionCentre && r.collectionCentre._id.toString() === c._id.toString() ? 'selected' : '' %>>
                            <%= c.name %> (<%= c.area %>)
                          </option>
                        <% }) %>
                      </select>

                      <button type="submit" class="btn btn-primary btn-sm" style="font-size: 0.75rem; padding: 0.3rem;">
                        <i class="fa-solid fa-user-check"></i> <%= r.status === 'Scheduled' ? 'Re-Assign Agent' : 'Assign Agent & Schedule' %>
                      </button>
                    </form>

                    <% if (r.status === 'Scheduled' || r.status === 'Collected') { %>
                      <form action="/admin/request/<%= r._id %>/status" method="POST" style="margin-top: 0.3rem;">
                        <input type="hidden" name="status" value="Recycled">
                        <button type="submit" class="btn btn-accent btn-sm" style="font-size: 0.75rem; width: 100%; padding: 0.25rem;">
                          <i class="fa-solid fa-leaf"></i> Submit as Recycled
                        </button>
                      </form>
                    <% } %>
                  <% } else { %>
                    <span style="font-size: 0.85rem; color: var(--text-muted); font-style: italic;">Completed (<%= r.status %>)</span>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</main>

<script>
  function toggleRejectForm(id) {
    const el = document.getElementById('reject-form-' + id);
    if (el) {
      el.style.display = el.style.display === 'none' ? 'block' : 'none';
    }
  }
</script>

<%- include('../partials/footer') %>
