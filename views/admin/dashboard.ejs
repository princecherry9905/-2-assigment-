<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="app-container">
  <%- include('../partials/alerts') %>

  <div class="dashboard-header" style="display: flex; justify-content: space-between; align-items: flex-end;">
    <div>
      <h1 class="welcome-title">Admin Recycling Portal</h1>
      <p class="sub-title">Overview of e-waste collection requests, logistics, agents, and recycling statistics</p>
    </div>
    <a href="/admin/requests" class="btn btn-primary">
      <i class="fa-solid fa-list-check"></i> Manage All Requests
    </a>
  </div>

  <!-- ADMIN STATS GRID -->
  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon blue">
        <i class="fa-solid fa-inbox"></i>
      </div>
      <div class="stat-info">
        <h3><%= totalRequests %></h3>
        <p>Total Requests</p>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon">
        <i class="fa-solid fa-dumpster-fire"></i>
      </div>
      <div class="stat-info">
        <h3><%= totalWeightTons %> <span style="font-size: 1rem;">Tons</span></h3>
        <p>Collected (<%= totalWeightKg %> KG)</p>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon purple">
        <i class="fa-solid fa-recycle"></i>
      </div>
      <div class="stat-info">
        <h3><%= recycledCount %></h3>
        <p>Recycled Pickups</p>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon amber">
        <i class="fa-solid fa-user-shield"></i>
      </div>
      <div class="stat-info">
        <h3><%= agentCount %></h3>
        <p>Active Agents</p>
      </div>
    </div>
  </div>

  <!-- RECENT PICKUP REQUESTS TABLE -->
  <div class="content-card">
    <div class="card-title">
      <span><i class="fa-solid fa-clock"></i> Recent Pickup Requests</span>
      <a href="/admin/requests" style="font-size: 0.85rem; color: var(--primary-accent-hover); font-weight: 600;">View All Requests &rarr;</a>
    </div>

    <% if (recentRequests.length === 0) { %>
      <div style="text-align: center; padding: 2rem 1rem; color: var(--text-muted);">
        <p>No pickup requests submitted yet.</p>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="custom-table">
          <thead>
            <tr>
              <th>Request ID</th>
              <th>Citizen</th>
              <th>Category</th>
              <th>Weight</th>
              <th>Status</th>
              <th>Assigned Agent</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody>
            <% recentRequests.forEach(function(r) { %>
              <tr>
                <td style="font-weight: 700; color: var(--primary-dark);">#<%= r._id.toString().slice(-6).toUpperCase() %></td>
                <td>
                  <strong><%= r.citizen ? r.citizen.name : 'Unknown' %></strong><br>
                  <span style="font-size: 0.75rem; color: var(--text-muted);"><%= r.citizen ? r.citizen.email : '' %></span>
                </td>
                <td><%= r.category ? r.category.icon : '📱' %> <%= r.category ? r.category.name : 'N/A' %></td>
                <td><strong><%= r.approximateWeight %> KG</strong></td>
                <td><span class="status-badge badge-<%= r.status.toLowerCase() %>"><%= r.status %></span></td>
                <td><%= r.agent ? r.agent.name : 'Unassigned' %></td>
                <td>
                  <% if (r.status === 'Requested') { %>
                    <form action="/admin/request/<%= r._id %>/approve" method="POST" style="display: inline;">
                      <button type="submit" class="btn btn-accent btn-sm">Approve</button>
                    </form>
                  <% } else if (r.status === 'Approved') { %>
                    <a href="/admin/requests" class="btn btn-primary btn-sm">Assign Agent</a>
                  <% } else { %>
                    <a href="/admin/requests" class="btn btn-outline btn-sm">View</a>
                  <% } %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</main>

<%- include('../partials/footer') %>
