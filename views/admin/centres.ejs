<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="app-container">
  <%- include('../partials/alerts') %>

  <div class="dashboard-header" style="display: flex; justify-content: space-between; align-items: center;">
    <div>
      <h1 class="welcome-title">Collection Centres</h1>
      <p class="sub-title">Maintain designated e-waste collection, sorting, and processing facilities</p>
    </div>
    <button class="btn btn-accent" onclick="toggleAddCentreForm()">
      <i class="fa-solid fa-plus-circle"></i> Add Collection Centre
    </button>
  </div>

  <!-- ADD CENTRE FORM -->
  <div id="add-centre-card" class="content-card" style="display: none; background: #F8FAFC; border: 2px solid var(--primary-accent);">
    <h3 style="font-size: 1.15rem; font-weight: 700; margin-bottom: 1rem; color: var(--primary-dark);">
      <i class="fa-solid fa-building"></i> Add New Collection Centre
    </h3>

    <form action="/admin/centre/create" method="POST">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
        <div class="form-group">
          <label class="form-label">Centre Name</label>
          <input type="text" name="name" class="form-control" placeholder="e.g. Green Recycling Centre" required>
        </div>
        <div class="form-group">
          <label class="form-label">Area / Region</label>
          <input type="text" name="area" class="form-control" placeholder="e.g. Ghaziabad / Noida" required>
        </div>
        <div class="form-group">
          <label class="form-label">Contact Phone</label>
          <input type="text" name="contact" class="form-control" placeholder="e.g. +91 120 4567890" required>
        </div>
        <div class="form-group">
          <label class="form-label">Status</label>
          <select name="status" class="form-select">
            <option value="Active">Active</option>
            <option value="Inactive">Inactive</option>
          </select>
        </div>
      </div>
      <div class="form-group">
        <label class="form-label">Full Street Address</label>
        <input type="text" name="address" class="form-control" placeholder="e.g. Plot 42, Industrial Area Phase 1, Ghaziabad" required>
      </div>
      <div style="display: flex; gap: 0.5rem; justify-content: flex-end;">
        <button type="button" class="btn btn-outline" onclick="toggleAddCentreForm()">Cancel</button>
        <button type="submit" class="btn btn-primary">Save Centre</button>
      </div>
    </form>
  </div>

  <!-- CENTRES GRID / CARDS -->
  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.25rem;">
    <% if (centres.length === 0) { %>
      <div class="content-card" style="grid-column: 1 / -1; text-align: center; padding: 3rem 1rem;">
        <p>No collection centres added yet.</p>
      </div>
    <% } else { %>
      <% centres.forEach(function(c) { %>
        <div class="content-card" style="margin-bottom: 0;">
          <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 0.75rem;">
            <div>
              <span style="font-size: 0.75rem; font-weight: 700; color: var(--primary-accent-hover); text-transform: uppercase;">
                📍 <%= c.area %>
              </span>
              <h3 style="font-size: 1.2rem; font-weight: 700; color: var(--primary-dark);"><%= c.name %></h3>
            </div>
            <span class="status-badge <%= c.status === 'Active' ? 'badge-recycled' : 'badge-rejected' %>">
              <%= c.status %>
            </span>
          </div>

          <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 0.75rem;">
            <strong>Address:</strong> <%= c.address %><br>
            <strong>Contact:</strong> 📞 <%= c.contact %>
          </p>

          <div style="border-top: 1px solid var(--border-color); padding-top: 0.75rem; display: flex; justify-content: flex-end;">
            <button class="btn btn-outline btn-sm" onclick="toggleEditCentre('<%= c._id %>')">
              <i class="fa-solid fa-pen-to-square"></i> Edit Centre
            </button>
          </div>

          <!-- HIDDEN EDIT FORM -->
          <div id="edit-centre-<%= c._id %>" style="display: none; margin-top: 1rem; background: #F8FAFC; padding: 1rem; border-radius: 10px;">
            <form action="/admin/centre/<%= c._id %>/edit" method="POST">
              <div class="form-group">
                <label class="form-label">Name</label>
                <input type="text" name="name" class="form-control" value="<%= c.name %>" required>
              </div>
              <div class="form-group">
                <label class="form-label">Area</label>
                <input type="text" name="area" class="form-control" value="<%= c.area %>" required>
              </div>
              <div class="form-group">
                <label class="form-label">Contact</label>
                <input type="text" name="contact" class="form-control" value="<%= c.contact %>" required>
              </div>
              <div class="form-group">
                <label class="form-label">Address</label>
                <input type="text" name="address" class="form-control" value="<%= c.address %>" required>
              </div>
              <div class="form-group">
                <label class="form-label">Status</label>
                <select name="status" class="form-select">
                  <option value="Active" <%= c.status === 'Active' ? 'selected' : '' %>>Active</option>
                  <option value="Inactive" <%= c.status === 'Inactive' ? 'selected' : '' %>>Inactive</option>
                </select>
              </div>
              <button type="submit" class="btn btn-accent btn-sm" style="width: 100%;">Save Changes</button>
            </form>
          </div>
        </div>
      <% }) %>
    <% } %>
  </div>
</main>

<script>
  function toggleAddCentreForm() {
    const card = document.getElementById('add-centre-card');
    card.style.display = card.style.display === 'none' ? 'block' : 'none';
  }
  function toggleEditCentre(id) {
    const card = document.getElementById('edit-centre-' + id);
    card.style.display = card.style.display === 'none' ? 'block' : 'none';
  }
</script>

<%- include('../partials/footer') %>
