<%- include('../partials/header') %>
<%- include('../partials/navbar') %>

<main class="app-container" style="max-width: 860px;">
  <%- include('../partials/alerts') %>

  <div style="margin-bottom: 1.5rem;">
    <a href="/citizen/pickups" style="color: var(--text-muted); font-size: 0.9rem; font-weight: 600;">
      &larr; Back to My Pickups
    </a>
  </div>

  <div class="timeline-card">
    <div class="timeline-header">
      <div>
        <span style="font-size: 0.8rem; font-weight: 700; color: var(--primary-accent-hover);">PICKUP TRACKING</span>
        <h2 style="font-size: 1.6rem; font-weight: 800; color: var(--primary-dark);">
          Pickup #<%= pickup._id.toString().slice(-6).toUpperCase() %>
        </h2>
      </div>
      <div>
        <span class="status-badge badge-<%= pickup.status.toLowerCase() %>" style="font-size: 0.9rem; padding: 0.4rem 1rem;">
          <%= pickup.status %>
        </span>
      </div>
    </div>

    <!-- GRANULAR 8-STEP TIMELINE TRACK -->
    <div style="margin: 1.5rem 0; overflow-x: auto;">
      <div style="display: flex; justify-content: space-between; min-width: 680px; position: relative;">
        <!-- 1. Request Created -->
        <div style="text-align: center; flex: 1;">
          <div style="width: 32px; height: 32px; border-radius: 50%; background: #10B981; color: #FFF; margin: 0 auto; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700;">✓</div>
          <span style="font-size: 0.75rem; font-weight: 700; color: #0F382C; display: block; margin-top: 0.4rem;">Request Created</span>
        </div>

        <!-- 2. Admin Approved -->
        <div style="text-align: center; flex: 1;">
          <div style="width: 32px; height: 32px; border-radius: 50%; background: <%= ['Approved', 'Scheduled', 'Collected', 'Recycled'].includes(pickup.status) ? '#10B981' : '#E2E8F0' %>; color: #FFF; margin: 0 auto; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700;">
            <%= ['Approved', 'Scheduled', 'Collected', 'Recycled'].includes(pickup.status) ? '✓' : '2' %>
          </div>
          <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); display: block; margin-top: 0.4rem;">Admin Approved</span>
        </div>

        <!-- 3. Agent Assigned -->
        <div style="text-align: center; flex: 1;">
          <div style="width: 32px; height: 32px; border-radius: 50%; background: <%= ['Scheduled', 'Collected', 'Recycled'].includes(pickup.status) ? '#10B981' : '#E2E8F0' %>; color: #FFF; margin: 0 auto; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700;">
            <%= ['Scheduled', 'Collected', 'Recycled'].includes(pickup.status) ? '✓' : '3' %>
          </div>
          <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); display: block; margin-top: 0.4rem;">Agent Assigned</span>
        </div>

        <!-- 4. E-Waste Collected -->
        <div style="text-align: center; flex: 1;">
          <div style="width: 32px; height: 32px; border-radius: 50%; background: <%= ['Collected', 'Recycled'].includes(pickup.status) ? '#10B981' : '#E2E8F0' %>; color: #FFF; margin: 0 auto; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700;">
            <%= ['Collected', 'Recycled'].includes(pickup.status) ? '✓' : '4' %>
          </div>
          <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); display: block; margin-top: 0.4rem;">E-Waste Collected</span>
        </div>

        <!-- 5. At Collection Centre -->
        <div style="text-align: center; flex: 1;">
          <div style="width: 32px; height: 32px; border-radius: 50%; background: <%= ['Collected', 'Recycled'].includes(pickup.status) ? '#0F382C' : '#E2E8F0' %>; color: #FFF; margin: 0 auto; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700;">
            <%= ['Collected', 'Recycled'].includes(pickup.status) ? '●' : '5' %>
          </div>
          <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); display: block; margin-top: 0.4rem;">At Centre</span>
        </div>

        <!-- 6. Sorting -->
        <div style="text-align: center; flex: 1;">
          <div style="width: 32px; height: 32px; border-radius: 50%; background: <%= pickup.status === 'Recycled' ? '#10B981' : (pickup.status === 'Collected' ? '#F59E0B' : '#E2E8F0') %>; color: #FFF; margin: 0 auto; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700;">
            <%= pickup.status === 'Recycled' ? '✓' : '6' %>
          </div>
          <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); display: block; margin-top: 0.4rem;">Sorting</span>
        </div>

        <!-- 7. Recycling -->
        <div style="text-align: center; flex: 1;">
          <div style="width: 32px; height: 32px; border-radius: 50%; background: <%= pickup.status === 'Recycled' ? '#10B981' : '#E2E8F0' %>; color: #FFF; margin: 0 auto; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700;">
            <%= pickup.status === 'Recycled' ? '✓' : '7' %>
          </div>
          <span style="font-size: 0.75rem; font-weight: 600; color: var(--text-muted); display: block; margin-top: 0.4rem;">Recycling</span>
        </div>

        <!-- 8. Recycled Successfully -->
        <div style="text-align: center; flex: 1;">
          <div style="width: 32px; height: 32px; border-radius: 50%; background: <%= pickup.status === 'Recycled' ? '#10B981' : '#E2E8F0' %>; color: #FFF; margin: 0 auto; display: flex; align-items: center; justify-content: center; font-size: 0.8rem; font-weight: 700;">
            <%= pickup.status === 'Recycled' ? '✓' : '8' %>
          </div>
          <span style="font-size: 0.75rem; font-weight: 700; color: #047857; display: block; margin-top: 0.4rem;">Recycled</span>
        </div>
      </div>
    </div>

    <% if (pickup.status === 'Rejected') { %>
      <div class="alert alert-error" style="margin-top: 1rem;">
        <div>
          <strong>Rejection Notice:</strong> <%= pickup.rejectionReason || 'This request was rejected by admin.' %>
        </div>
      </div>
    <% } %>
  </div>

  <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem;" class="responsive-grid">
    <!-- ITEM DETAILS -->
    <div class="content-card">
      <h3 class="card-title"><i class="fa-solid fa-box"></i> Item Information</h3>
      <div style="display: flex; flex-direction: column; gap: 0.85rem; font-size: 0.95rem;">
        <div>
          <span style="color: var(--text-muted); font-size: 0.85rem;">Category</span>
          <p style="font-weight: 700; font-size: 1.1rem; color: var(--primary-dark);">
            <%= pickup.category ? pickup.category.icon : '📱' %> <%= pickup.category ? pickup.category.name : 'N/A' %>
          </p>
        </div>
        <div>
          <span style="color: var(--text-muted); font-size: 0.85rem;">Quantity & Weight</span>
          <p style="font-weight: 600;"><%= pickup.quantity %> Items • ⚖ <%= pickup.approximateWeight %> KG</p>
        </div>
        <div>
          <span style="color: var(--text-muted); font-size: 0.85rem;">Reward Rate</span>
          <p style="font-weight: 600; color: var(--primary-accent-hover);">
            +<%= pickup.category ? pickup.category.rewardPointsPerKg : 50 %> Eco Points & ₹<%= pickup.category ? (pickup.category.pricePerKg || 15) : 15 %> Cash per KG
          </p>
        </div>
        <% if (pickup.rewardPointsEarned > 0 || pickup.cashRewardEarned > 0) { %>
          <div style="background: #ECFDF5; border: 1px solid #A7F3D0; padding: 0.75rem; border-radius: 10px;">
            <span style="color: #065F46; font-size: 0.85rem; font-weight: 700;">REWARDS EARNED</span>
            <p style="font-size: 1.2rem; font-weight: 800; color: #047857; margin-top: 0.2rem;">
              +<%= pickup.rewardPointsEarned %> Eco Points 🎉<br>
              <span style="color: #059669; font-size: 1.1rem;">+₹<%= pickup.cashRewardEarned || (pickup.approximateWeight * 15).toFixed(2) %> Cash Reward 💵</span>
            </p>
          </div>
        <% } %>
      </div>
    </div>

    <!-- PICKUP DETAILS -->
    <div class="content-card">
      <h3 class="card-title"><i class="fa-solid fa-location-dot"></i> Schedule & Logistics</h3>
      <div style="display: flex; flex-direction: column; gap: 0.85rem; font-size: 0.95rem;">
        <div>
          <span style="color: var(--text-muted); font-size: 0.85rem;">Preferred Date</span>
          <p style="font-weight: 600;">📅 <%= new Date(pickup.preferredDate).toLocaleDateString('en-US', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></p>
        </div>
        <div>
          <span style="color: var(--text-muted); font-size: 0.85rem;">Pickup Address</span>
          <p style="font-weight: 600; line-height: 1.4;">📍 <%= pickup.address %></p>
        </div>
        <div>
          <span style="color: var(--text-muted); font-size: 0.85rem;">Assigned Agent</span>
          <p style="font-weight: 600;">
            <% if (pickup.agent) { %>
              👤 <%= pickup.agent.name %> (<%= pickup.agent.phone || 'Phone unavailable' %>)
            <% } else { %>
              <span style="color: var(--text-muted); font-style: italic;">Awaiting Agent Assignment</span>
            <% } %>
          </p>
        </div>
        <div>
          <span style="color: var(--text-muted); font-size: 0.85rem;">Target Collection Centre</span>
          <p style="font-weight: 600;">
            <% if (pickup.collectionCentre) { %>
              🏢 <%= pickup.collectionCentre.name %> (<%= pickup.collectionCentre.area %>)
            <% } else { %>
              <span style="color: var(--text-muted); font-style: italic;">Awaiting Assignment</span>
            <% } %>
          </p>
        </div>
      </div>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>
